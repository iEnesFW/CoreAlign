{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;corealign.local",
  "Jwt": {
    "Issuer": "CoreAlign.API",
    "Audience": "CoreAlign.Client",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:5273"]
  },
  "AiHelper": {
    "Enabled": true,
    "Provider": "Ollama",
    "BaseUrl": "http://localhost:11434",
    "ChatModel": "qwen2.5:7b",
    "EmbeddingModel": "bge-m3",
    "EmbeddingDimensions": 1024,
    "MaxContextChunks": 8,
    "NumThreads": 0,
    "MaxOutputTokens": 800,
    "Temperature": 0.2,
    "RequestTimeoutSeconds": 120,
    "PublicRateLimitPerMinute": 10,
    "AuthedRateLimitPerMinute": 30,
    "IngestModuleDocs": true,
    "IngestSourceCode": true,
    "SourceCodeExtensions": [".cs"]
  }
}
