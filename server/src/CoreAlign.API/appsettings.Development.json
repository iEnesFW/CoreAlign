{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Information"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:5273", "http://localhost:5173"]
  },
  "Auth": {
    "AutoConfirmEmail": true
  },
  "DemoData": {
    "Enabled": true
  },
  "DataProtection": {
    "KeyDirectory": "App_Data/dataprotection-keys"
  },
  "Billing": {
    "DefaultGatewayName": "mock",
    "EnableMockGateway": true
  }
}
