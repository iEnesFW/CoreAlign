{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Database": {
    "Provider": "Postgres",
    "AutoMigrate": false
  },
  "Jwt": {
    "Issuer": "CoreAlign.API",
    "Audience": "CoreAlign.Client",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7,
    "SecretKey": ""
  },
  "Auth": {
    "AutoConfirmEmail": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 200,
      "WindowSeconds": 60
    },
    "Auth": {
      "PermitLimit": 8,
      "WindowSeconds": 60
    }
  },
  "Billing": {
    "DefaultGatewayName": "iyzico",
    "EnableMockGateway": false,
    "Iyzico": {
      "ApiKey": "",
      "SecretKey": "",
      "BaseUrl": "https://api.iyzipay.com",
      "CallbackBaseUrl": "",
      "WebhookBaseUrl": "",
      "DefaultLocale": "tr",
      "AllowInstallments": true,
      "HttpTimeoutSeconds": 30
    }
  },
  "Email": {
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Username": "",
      "Password": "",
      "UseSsl": true,
      "FromAddress": "",
      "FromName": "CoreAlign"
    }
  },
  "Sentry": {
    "Dsn": "",
    "Environment": "production",
    "Release": "",
    "TracesSampleRate": 0.2
  },
  "OpenTelemetry": {
    "ServiceName": "CoreAlign.API",
    "OtlpEndpoint": "",
    "MetricsEnabled": true,
    "TracingEnabled": true,
    "TracesSampleRatio": 0.1
  },
  "Configuration": {
    "VaultProvider": "None",
    "AzureKeyVaultUri": "",
    "AwsSsmPath": "",
    "AwsRegion": ""
  }
}
