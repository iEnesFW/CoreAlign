{
  "name": "corealign",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender-seo.mjs",
    "prerender": "node scripts/prerender-seo.mjs",
    "gen:ai-kb": "node scripts/ai-kb/extract-frontend.mjs",
    "eval:ai-kb": "node scripts/ai-kb/eval.mjs",
    "gen:og": "node scripts/gen-og-image.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "check:bundle": "node scripts/check-bundle-size.mjs --dist dist",
    "check:bundle:customer-portal": "node scripts/check-bundle-size.mjs --dist apps/customer-portal/dist",
    "check:bundle:b2b": "node scripts/check-bundle-size.mjs --dist apps/b2b/dist",
    "check:bundle:all": "npm run check:bundle && npm run check:bundle:customer-portal && npm run check:bundle:b2b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "designer:probe": "node e2e/designer/harness.mjs",
    "e2e": "playwright test --config=e2e/playwright.config.ts",
    "e2e:admin": "playwright test --config=e2e/playwright.config.ts --project=admin",
    "e2e:customer": "playwright test --config=e2e/playwright.config.ts --project=customer-portal",
    "e2e:b2b": "playwright test --config=e2e/playwright.config.ts --project=b2b",
    "e2e:ui": "playwright test --config=e2e/playwright.config.ts --ui",
    "e2e:headed": "playwright test --config=e2e/playwright.config.ts --headed",
    "e2e:debug": "playwright test --config=e2e/playwright.config.ts --debug",
    "e2e:report": "playwright show-report e2e/playwright-report",
    "e2e:codegen": "playwright codegen",
    "e2e:list": "playwright test --config=e2e/playwright.config.ts --list",
    "e2e:typecheck": "tsc --noEmit --project e2e/tsconfig.json",
    "e2e:install": "playwright install --with-deps chromium",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/sora": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@sentry/react": "^10.57.0",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.90.21",
    "@types/three": "^0.182.0",
    "axios": "^1.13.5",
    "clsx": "^2.1.1",
    "country-state-city": "^3.2.1",
    "i18next": "^25.8.14",
    "i18next-browser-languagedetector": "^8.2.1",
    "lightningcss": "^1.31.1",
    "lil-gui": "^0.21.0",
    "lucide-react": "^0.574.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-google-recaptcha-v3": "^1.11.0",
    "react-hook-form": "^7.75.0",
    "react-i18next": "^16.5.6",
    "react-joyride": "^3.1.0",
    "react-markdown": "^10.1.0",
    "react-phone-number-input": "^3.4.16",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.1",
    "tailwindcss": "^4.2.1",
    "three": "^0.183.0",
    "three-csg-ts": "^3.2.0",
    "three-mesh-bvh": "^0.9.13",
    "zod": "^4.4.3",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.48.2",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/recharts": "^1.8.29",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.6",
    "@vitest/ui": "^4.1.6",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.6"
  }
}
